<Window x:Class="WpfTananyagDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfTananyagDemo"
        mc:Ignorable="d"
        Title="Teljes WPF Tananyag Felület" Height="700" Width="950">

    <!-- LEGKÜLSŐ TÁROLÓ: DockPanel (Szélekhez tapaszt, közepe kitöltődik) -->
    <DockPanel LastChildFill="True">
        <!-- 1. Tetejére: Menüsáv -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Fájl"/>
            <MenuItem Header="Szerkesztés"/>
            <MenuItem Header="Kilépés"/>
        </Menu>
        <!-- 2. Tetejére: Eszköztár -->
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Új" />
            <Separator />
            <Button Content="Mentés" />
            <Separator />
            <CheckBox Content="Gyors nézet" />
        </ToolBar>
        <!-- 3. Aljára: Állapotsor -->
        <StatusBar>
            <StatusBarItem>
                <TextBlock Text="Rendszer kész" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <ProgressBar Value="60" Width="100" Height="15" />
            </StatusBarItem>
        </StatusBar>
        <!-- 4. Középre: TabControl (Kiterjed a teljes fennmaradó helyre) -->
        <TabControl Margin="5">
            <!-- ==================== 1. FÜL: LAYOUTOK ==================== -->
            <TabItem Header="Layoutok">
                <Grid>
                    <!-- Grid sorméretek: Auto (tartalom), 100 (fix DIP), * és 2* (arányos) -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <!-- StackPanel: egymás alá függőlegesen -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical" Margin="5">
                        <TextBlock Text="Függőleges halmozás" FontWeight="Bold"/>
                        <Button Content="Gomb 1" Margin="2" />
                        <Button Content="Gomb 2" Margin="2" />
                    </StackPanel>
                    <!-- WrapPanel: sorba törés elrendezés -->
                    <WrapPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" ItemWidth="90" ItemHeight="35">
                        <Button Content="1. Elem" />
                        <Button Content="2. Elem" />
                        <Button Content="3. Elem" />
                        <Button Content="4. Elem" />
                    </WrapPanel>
                    <!-- Canvas abszolút pozicionálással és ZIndex-szel (Row 1, ColumnSpan 2) -->
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
